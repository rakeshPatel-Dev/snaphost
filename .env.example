## Public Umami website ID. Leave empty to disable Umami analytics.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

## Canonical deployed app URL, used when provisioning the QStash cleanup schedule.
NEXT_PUBLIC_BASE_URL=https://your-domain.example

## QStash authenticates the scheduled expired-upload cleanup request.
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
