## ── Supabase ─────────────────────────────────────────────────────────────────
## Required. Project URL and anon key for the browser Supabase client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

## Required, server-only. Admin key that bypasses RLS. Never expose this to the
## browser; it is only read by lib/server/* (guarded with `import 'server-only'`).
SUPABASE_SERVICE_ROLE_KEY=

## Optional. Comma-separated OAuth providers shown on the auth screen (google,github).
NEXT_PUBLIC_SUPABASE_AUTH_PROVIDERS=google,github

## Optional. Storage bucket name (defaults to `files`).
NEXT_PUBLIC_STORAGE_BUCKET=files

## ── Site / branding ────────────────────────────────────────────────────────────
## Canonical deployed app URL used for generated share links and by the QStash
## cleanup schedule. Falls back to the SITE_URL constant in data/emails.ts.
## Set this when deploying on a custom domain.
NEXT_PUBLIC_BASE_URL=https://your-domain.example

## Public Umami website ID. Leave empty to disable Umami analytics.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

## Optional. Formspree endpoint ID used by the beta/feedback forms. When unset
## the forms render with a "missing-id" placeholder.
NEXT_PUBLIC_FORMSPREE_ENDPOINT_ID=

## ── Upstash Redis (upload rate limiting) ─────────────────────────────────────
## Required in production. Upload endpoints return 503 when these are missing.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

## ── QStash (scheduled expired-upload cleanup) ────────────────────────────────
## Production: verifies signed requests to /api/jobs/cleanup-expired.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

## Provisioning only: used by `npm run cleanup:provision` to create/update the
## remote schedule against your region's QStash endpoint.
QSTASH_TOKEN=
QSTASH_URL=